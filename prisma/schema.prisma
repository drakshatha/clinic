generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Staff (doctor + assistant logins) ───────────────────────────────────────
model StaffUser {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   // free-text display label e.g. "Doctor", "Receptionist"
  permissions  String   @default("[]") // JSON array of permission keys
  isOwner      Boolean  @default(false) // owner can never be deleted
  createdAt    DateTime @default(now())

  confirmedLeads  Lead[]          @relation("ConfirmedBy")
  sessions        Session[]
  treatmentPlans  TreatmentPlan[]
  prescriptions   Prescription[]
}

model Session {
  token       String    @id
  userId      String
  role        String
  name        String
  permissions String    @default("[]") // JSON array of permission keys
  expiresAt   DateTime
  user        StaffUser @relation(fields: [userId], references: [id])
}

// ─── Appointment Leads ────────────────────────────────────────────────────────
model Lead {
  id                    String    @id @default(cuid())
  name                  String
  phone                 String
  email                 String    @default("")
  treatment             String    @default("")
  message               String    @default("")
  slotDate              String    // YYYY-MM-DD
  slotTime              String    // e.g. "5:30 PM"
  status                String    @default("pending") // pending | confirmed | completed | cancelled | no_show
  source                String    @default("website")
  confirmedById         String?
  confirmedAt           DateTime?
  whatsappConfirmSent   Boolean   @default(false)
  reminder24hSent       Boolean   @default(false)
  reminder1hSent        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  confirmedBy   StaffUser?   @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  patient       Patient?     @relation(fields: [patientPhone], references: [phone])
  patientPhone  String?
  consultation  Consultation?
  documents     Document[]
  feedback      VisitFeedback?
  labWork       LabWork[]
  prescriptions Prescription[]
}

// ─── Blocked Slots ────────────────────────────────────────────────────────────
model BlockedSlot {
  id     String @id @default(cuid())
  date   String // YYYY-MM-DD
  time   String // e.g. "5:30 PM"
  reason String @default("")

  @@unique([date, time])
}

// ─── OTP Records ──────────────────────────────────────────────────────────────
model OtpRecord {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
}

// ─── Patient Portal ───────────────────────────────────────────────────────────
model Patient {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String    @default("")
  email        String    @default("")
  dob          String?   // YYYY-MM-DD for birthday WhatsApp
  gender       String?   // "male" | "female" | "other"
  joinedAt     DateTime  @default(now())
  lastSeen     DateTime  @default(now())
  lastRecallAt DateTime? // when we last sent a recall WhatsApp

  leads          Lead[]
  consultations  Consultation[]
  portalSessions PatientSession[]
  medicalHistory MedicalHistory?
  treatmentPlans TreatmentPlan[]
  dentalChart    DentalChart?
  prescriptions  Prescription[]
  images         PatientImage[]
  consentForms   ConsentForm[]
}

model PatientSession {
  token     String   @id
  phone     String
  expiresAt DateTime
  patient   Patient  @relation(fields: [phone], references: [phone])
}

// ─── Consultation History ─────────────────────────────────────────────────────
model Consultation {
  id              String   @id @default(cuid())
  leadId          String   @unique
  patientPhone    String
  visitType       String   @default("consultation") // consultation | treatment | followup | resolved
  treatmentDone   String   @default("")
  notes           String   @default("")
  nextVisitDate   String?  // YYYY-MM-DD (required when visitType = followup)
  completedAt     DateTime @default(now())

  // Payment
  paymentMode     String?  // cash | upi | card | online | waived
  paymentAmount   Float?
  transactionId   String?  // for upi / online payments
  invoiceSent     Boolean  @default(false)

  lead      Lead       @relation(fields: [leadId], references: [id])
  patient   Patient    @relation(fields: [patientPhone], references: [phone])
  documents Document[]
}

// ─── Offers / Promotions ──────────────────────────────────────────────────────
model Offer {
  id          String   @id @default(cuid())
  badge       String   @default("OFFER")   // e.g. "20% OFF", "FREE", "LIMITED"
  title       String                        // e.g. "Free Consultation This Week"
  description String   @default("")         // optional sub-text
  imageUrl    String?                       // optional Vercel Blob image URL
  validUntil  String?                       // YYYY-MM-DD, null = no expiry
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Medical History (patient intake form) ────────────────────────────────────
model MedicalHistory {
  id                    String   @id @default(cuid())
  patientPhone          String   @unique
  bloodGroup            String   @default("")
  allergies             String   @default("") // free text
  currentMedications    String   @default("") // free text
  medicalConditions     String   @default("") // e.g. diabetes, hypertension
  smokingStatus         String   @default("") // never | former | current
  isPregnant            String   @default("") // yes | no | na
  dentalConcerns        String   @default("") // free text chief complaint
  emergencyContactName  String   @default("")
  emergencyContactPhone String   @default("")
  updatedAt             DateTime @updatedAt

  patient Patient @relation(fields: [patientPhone], references: [phone])
}

// ─── Documents (X-rays, reports, prescriptions) ───────────────────────────────
model Document {
  id           String   @id @default(cuid())
  leadId       String
  patientPhone String   @default("")
  fileName     String
  fileUrl      String   // Vercel Blob URL
  fileSize     Int?     // bytes
  mimeType     String   @default("")
  docType      String   @default("other") // xray | report | prescription | other
  uploadedById String   // StaffUser id
  createdAt    DateTime @default(now())

  lead         Lead          @relation(fields: [leadId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  consultationId String?
}

// ─── Treatment Plan Builder ───────────────────────────────────────────────────
model TreatmentPlan {
  id           String   @id @default(cuid())
  patientPhone String
  title        String                    // e.g. "Full Mouth Rehabilitation Plan"
  notes        String   @default("")    // overall notes for the doctor
  totalCost    Float    @default(0)     // sum of phase costs (auto-computed)
  status       String   @default("draft") // draft | shared | accepted
  createdById  String
  sharedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient   Patient   @relation(fields: [patientPhone], references: [phone])
  createdBy StaffUser @relation(fields: [createdById], references: [id])
  phases    TreatmentPlanPhase[]
}

model TreatmentPlanPhase {
  id            String   @id @default(cuid())
  planId        String
  phaseNumber   Int
  title         String                  // e.g. "Phase 1: Extractions"
  description   String   @default("")
  estimatedCost Float    @default(0)
  duration      String   @default("")  // e.g. "1-2 weeks", "Same day"
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// ─── Visit Feedback + Google Review ──────────────────────────────────────────
model VisitFeedback {
  id              String    @id @default(cuid())
  token           String    @unique   // random token for feedback URL
  leadId          String    @unique
  patientPhone    String
  rating          Int?                // 1-5; null until patient submits
  comment         String    @default("")
  reviewRequested Boolean   @default(false)  // true when we sent Google review link
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

// ─── Lab Work Tracker ─────────────────────────────────────────────────────────
model LabWork {
  id           String   @id @default(cuid())
  leadId       String
  patientPhone String
  patientName  String   @default("")
  labName      String
  workType     String   @default("other") // crown | bridge | denture | implant-crown | other
  description  String   @default("")
  sentDate     String                     // YYYY-MM-DD
  expectedDate String?                    // YYYY-MM-DD
  receivedDate String?                    // YYYY-MM-DD
  status       String   @default("sent")  // sent | received | fitted
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])
}

// ─── Before/After Gallery ─────────────────────────────────────────────────────
model GalleryCase {
  id          String   @id @default(cuid())
  title       String                    // e.g. "Full Mouth Rehabilitation"
  treatment   String   @default("")
  beforeUrl   String                    // Vercel Blob URL
  afterUrl    String                    // Vercel Blob URL
  description String   @default("")
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Dental Chart ─────────────────────────────────────────────────────────────
model DentalChart {
  id           String   @id @default(cuid())
  patientPhone String   @unique
  // JSON object: { "11": "cavity", "14": "crown", ... }
  // Conditions: healthy | cavity | filling | crown | implant | missing | root_canal | extraction_needed | bridge | veneer
  teeth        String   @default("{}")
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientPhone], references: [phone])
}

// ─── Patient X-rays / Images ──────────────────────────────────────────────────
model PatientImage {
  id           String   @id @default(cuid())
  patientPhone String
  label        String   @default("")   // e.g. "OPG", "CBCT", "Periapical #15"
  imageData    String                  // base64 data URI (TEXT in postgres)
  uploadedById String   @default("")
  createdAt    DateTime @default(now())

  patient Patient @relation(fields: [patientPhone], references: [phone])
}

// ─── Consent Forms ────────────────────────────────────────────────────────────
model ConsentForm {
  id            String    @id @default(cuid())
  patientPhone  String
  title         String                 // "Extraction Consent", "Implant Consent"
  content       String                 // full consent text
  signatureData String    @default("") // base64 canvas signature
  signedAt      DateTime?
  createdById   String    @default("")
  createdAt     DateTime  @default(now())

  patient Patient @relation(fields: [patientPhone], references: [phone])
}

// ─── Inventory / Consumables ──────────────────────────────────────────────────
model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("general") // anesthesia | composites | instruments | ppe | general
  unit         String   @default("pcs")     // pcs | box | ml | gm | roll
  currentStock Int      @default(0)
  minStock     Int      @default(5)
  costPerUnit  Float    @default(0)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs InventoryLog[]
}

model InventoryLog {
  id        String   @id @default(cuid())
  itemId    String
  change    Int                        // positive = restocked, negative = used
  note      String   @default("")
  staffId   String   @default("")
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ─── Prescriptions ────────────────────────────────────────────────────────────
model Prescription {
  id             String   @id @default(cuid())
  patientPhone   String
  patientName    String   @default("")
  leadId         String?
  chiefComplaint String   @default("")
  diagnosis      String   @default("")
  // JSON array: [{ drug, dosage, frequency, duration, instructions }]
  medications    String   @default("[]")
  advice         String   @default("")
  createdById    String
  createdAt      DateTime @default(now())

  patient   Patient   @relation(fields: [patientPhone], references: [phone])
  createdBy StaffUser @relation(fields: [createdById], references: [id])
  lead      Lead?     @relation(fields: [leadId], references: [id])
}
